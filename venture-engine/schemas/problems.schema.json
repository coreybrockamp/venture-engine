{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem",
  "type": "object",
  "required": ["problem_id", "created_at", "updated_at", "persona_id", "problem_statement", "job_to_be_done", "problem_category", "confidence_score", "evidence_strength", "source_observation_ids", "status", "date_last_validated"],
  "properties": {
    "problem_id": {"type": "string", "pattern": "^PROB-[0-9]{4}$"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"},
    "persona_id": {"type": "string", "pattern": "^PER-[0-9]{3}$"}, "persona_name": {"type": "string"}, "problem_statement": {"type": "string"}, "job_to_be_done": {"type": "string"},
    "problem_category": {"type": ["string", "null"]}, "problem_subcategory": {"type": ["string", "null"]}, "description": {"type": ["string", "null"]}, "trigger_event": {"type": ["string", "null"]}, "desired_outcome": {"type": ["string", "null"]},
    "frequency": {"type": ["integer", "string", "null"]}, "frequency_evidence": {"type": ["string", "null"]}, "severity": {"type": ["integer", "string", "null"]}, "severity_evidence": {"type": ["string", "null"]}, "urgency": {"type": ["integer", "string", "null"]}, "urgency_evidence": {"type": ["string", "null"]}, "emotional_intensity": {"type": ["integer", "string", "null"]},
    "existing_solution": {"type": ["string", "null"]}, "existing_solution_type": {"type": ["string", "null"]}, "workaround": {"type": ["string", "null"]}, "workaround_cost": {"type": ["string", "null"]}, "money_currently_spent": {"type": ["string", "number", "null"]}, "spending_frequency": {"type": ["string", "null"]}, "spending_evidence": {"type": ["string", "null"]}, "time_currently_spent": {"type": ["string", "null"]}, "time_frequency": {"type": ["string", "null"]}, "current_solution_satisfaction": {"type": ["integer", "string", "null"]},
    "complaint_count": {"type": ["integer", "null"]}, "independent_source_count": {"type": ["integer", "null"]}, "search_demand": {"type": ["string", "null"]}, "search_demand_evidence": {"type": ["string", "null"]}, "competitor_count": {"type": ["integer", "null"]}, "competitor_quality": {"type": ["string", "null"]}, "willingness_to_pay": {"type": ["string", "null"]}, "willingness_to_pay_evidence": {"type": ["string", "null"]}, "switching_cost": {"type": ["string", "null"]}, "customer_reachability": {"type": ["string", "null"]}, "market_size_estimate": {"type": ["string", "null"]}, "market_size_method": {"type": ["string", "null"]},
    "software_solvability": {"type": ["integer", "null"], "minimum": 1, "maximum": 10}, "ai_solvability": {"type": ["integer", "null"], "minimum": 1, "maximum": 10}, "service_solvability": {"type": ["integer", "null"], "minimum": 1, "maximum": 10}, "regulatory_complexity": {"type": ["string", "null"]}, "trust_requirement": {"type": ["string", "null"]}, "behavior_change_required": {"type": ["string", "null"]},
    "confidence_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}, "evidence_strength": {"type": "integer", "minimum": 1, "maximum": 5}, "source_observation_ids": {"type": "array", "items": {"type": "string", "pattern": "^OBS-[0-9]{6}$"}}, "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^OBS-[0-9]{6}$"}}, "related_problem_ids": {"type": "array", "items": {"type": "string", "pattern": "^PROB-[0-9]{4}$"}}, "status": {"enum": ["candidate", "researching", "validated", "deprioritized", "rejected", "archived"]}, "date_last_validated": {"type": ["string", "null"], "format": "date"}, "notes": {"type": ["string", "null"]}
  }, "additionalProperties": false
}
